	(model "${KICAD_CUSTOM_3D_DIR}/Jetson_Orin_Nano.stp"
		(offset
			(xyz 32.8 -2 5.5)
		)
		(scale
			(xyz 1 1 1)
		)
		(rotate
			(xyz -0 -0 -180)
		)
	)
)
